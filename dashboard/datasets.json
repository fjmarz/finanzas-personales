        "kind": "call",
        "connector": "Google Sheets",
        "tool": "get_values",
        "args": {
          "spreadsheetId": "{{planilla}}",
          "range": "Activos!A1:K200"
        },
        "rules": {
          "planilla": {
            "pattern": "^[A-Za-z0-9_-]{25,60}$"
